def count_ones(values):

    total = 0

    for number in values:

        if number == 1:

            total += 1

    return total


def transform(values):

    result = []

    for number in values:

        if number == 0:

            result.append(1)

        else:

            result.append(-1)

    return result


def kadane(values):

    current = values[0]

    best = values[0] 

    index = 1

    while index < len(values):

        current = max(
            values[index],
            current + values[index]
        )

        if current > best:

            best = current

        index += 1

    return best


